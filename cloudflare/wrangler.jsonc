{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ddns",
  "main": "ddns.js",
  "compatibility_date": "2026-04-21",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  },
  "vars": {
    "MIKROTIK_HOSTNAME": "hga09qpb37c.sn.mynetname.net",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
